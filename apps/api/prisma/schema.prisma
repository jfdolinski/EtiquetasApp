// Banco próprio da plataforma. Toda tabela de dados do tenant tem `empresa_id`.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusAssinatura {
  ATIVA
  CARENCIA
  BLOQUEADA
  CANCELADA
}

model Empresa {
  id               String           @id @default(uuid()) @db.Uuid
  razaoSocial      String           @map("razao_social")
  nomeFantasia     String?          @map("nome_fantasia")
  /// Normalizado: 14 caracteres, sem máscara, maiúsculo (aceita CNPJ alfanumérico).
  cnpj             String           @unique @db.VarChar(14)
  codigoErp        String?          @map("codigo_erp")
  plano            String           @default("padrao")
  statusAssinatura StatusAssinatura @default(ATIVA) @map("status_assinatura")
  ativa            Boolean          @default(true)
  /// Veio do "Cadastre-se" com CNPJ novo: fica inativa até o super-admin aprovar.
  aprovacaoPendente Boolean         @default(false) @map("aprovacao_pendente")
  /// Situação na Receita lida no cadastro; nula quando a consulta estava fora do ar.
  situacaoReceita  String?          @map("situacao_receita")
  /// ERP usado pela empresa; o template dele pode ser copiado para as consultas da empresa.
  sistemaErpId     String?          @map("sistema_erp_id") @db.Uuid
  criadoEm         DateTime         @default(now()) @map("criado_em")
  atualizadoEm     DateTime         @updatedAt @map("atualizado_em")

  usuarios           Usuario[]
  perfis             Perfil[]
  logs               LogAuditoria[]
  agentes            Agente[]
  conexoes           ConexaoBanco[]
  consultas          ConsultaSql[]
  perfisTela PerfilTela[]
  telas Tela[]
  conteudosTela ConteudoTela[]
  imagensTela ImagemTela[]
  produtosBanidos    ProdutoBanido[]
  modelos            ModeloEtiqueta[]
  impressoras        Impressora[]
  listas             ListaDiaria[]
  trabalhos          TrabalhoImpressao[]
  sistemaErp         SistemaErp?           @relation(fields: [sistemaErpId], references: [id], onDelete: Restrict)
  assinatura         Assinatura?
  parametrosCobranca ParametroCobranca?
  pagamentos         PagamentoAssinatura[]
  avisosCobranca     AvisoCobranca[]
  agendamentos       AgendamentoModelo[]
  execucoesConsulta  ExecucaoConsulta[]
  regrasNotificacao  RegraNotificacao[]
  janelaNotificacao  JanelaNotificacao?
  notificacoes       Notificacao[]
  dispositivos DispositivoMovel[]
  posts        PostSocial[]
  imagensPost  ImagemPost[]
  marcaPost    MarcaPost?

  @@map("empresas")
}

model Usuario {
  id            String    @id @default(uuid()) @db.Uuid
  /// Nulo apenas para super-admins da plataforma.
  empresaId     String?   @map("empresa_id") @db.Uuid
  perfilId      String?   @map("perfil_id") @db.Uuid
  nome          String
  /// Sempre em minúsculas; único em toda a plataforma.
  email         String    @unique
  senhaHash     String    @map("senha_hash")
  superAdmin    Boolean   @default(false) @map("super_admin")
  ativo         Boolean   @default(true)
  /// Veio do "Cadastre-se" e aguarda aprovação (sempre com ativo = false).
  cadastroPendente Boolean  @default(false) @map("cadastro_pendente")
  ultimoLoginEm DateTime? @map("ultimo_login_em")
  /// Verificação em duas etapas: ativa quando totpAtivoEm está preenchido.
  totpSegredoCifrado     String?   @map("totp_segredo_cifrado")
  totpAtivoEm            DateTime? @map("totp_ativo_em")
  /// Último passo aceito: o mesmo código não entra duas vezes.
  totpUltimoPasso        BigInt?   @map("totp_ultimo_passo")
  totpFalhas             Int       @default(0) @map("totp_falhas")
  totpBloqueadoAte       DateTime? @map("totp_bloqueado_ate")
  /// SHA-256 dos códigos de recuperação ainda não usados.
  totpCodigosRecuperacao String[]  @default([]) @map("totp_codigos_recuperacao")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")

  empresa      Empresa?              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  perfil       Perfil?               @relation(fields: [perfilId], references: [id], onDelete: SetNull)
  logs         LogAuditoria[]
  trabalhos    TrabalhoImpressao[]
  pagamentos   PagamentoAssinatura[]
  agendamentos AgendamentoModelo[]
  sessoes      SessaoUsuario[]
  dispositivos DispositivoMovel[]
  vinculosApp  CodigoVinculoApp[]
  redefinicoes RedefinicaoSenha[]
  conteudosTela ConteudoTela[]

  @@index([empresaId])
  @@map("usuarios")
}

/// Um login no navegador. O JWT carrega o id: encerrar aqui derruba o token na hora.
model SessaoUsuario {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  descricao   String?
  ip          String?
  criadoEm    DateTime  @default(now()) @map("criado_em")
  ultimoUsoEm DateTime  @default(now()) @map("ultimo_uso_em")
  expiraEm    DateTime  @map("expira_em")
  encerradaEm DateTime? @map("encerrada_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, encerradaEm])
  @@index([expiraEm])
  @@map("sessoes_usuario")
}

/// Celular vinculado a um usuário pelo QR code de Minha conta. Só o hash do token fica guardado.
model DispositivoMovel {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  /// Empresa em que o app opera: a do usuário ou a selecionada pelo super-admin ao gerar o QR.
  empresaId   String    @map("empresa_id") @db.Uuid
  nome        String
  plataforma  String
  versaoApp   String?   @map("versao_app")
  tokenHash   String    @unique @map("token_hash")
  /// Token do Firebase para avisos com o app fechado.
  pushToken   String?   @map("push_token")
  criadoEm    DateTime  @default(now()) @map("criado_em")
  ultimoUsoEm DateTime  @default(now()) @map("ultimo_uso_em")
  revogadoEm  DateTime? @map("revogado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revogadoEm])
  @@index([empresaId, revogadoEm])
  @@index([pushToken])
  @@map("dispositivos_moveis")
}

/// Código de uso único mostrado no QR, válido por poucos minutos.
model CodigoVinculoApp {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  empresaId  String    @map("empresa_id") @db.Uuid
  codigoHash String    @unique @map("codigo_hash")
  expiraEm   DateTime  @map("expira_em")
  usadoEm    DateTime? @map("usado_em")
  criadoEm   DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, usadoEm])
  @@index([expiraEm])
  @@map("codigos_vinculo_app")
}

/// Índice de campos das consultas: o que cada alias significa no sistema. Dado da plataforma.
model ReferenciaCampo {
  id            String   @id @default(uuid()) @db.Uuid
  alias         String   @unique
  nome          String
  descricao     String   @default("")
  exemplo       String   @default("")
  /// Outros nomes de coluna entendidos como este campo.
  alternativos  String[] @default([])
  /// Finalidades (FinalidadeConsulta) em que a consulta precisa trazer o campo.
  obrigatoriaEm String[] @default([]) @map("obrigatoria_em")
  /// O código do sistema lê este campo pelo nome: alias e alternativos não mudam.
  sistema       Boolean  @default(false)
  ativa         Boolean  @default(true)
  ordem         Int      @default(0)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  @@map("referencias_campo")
}

/// Propaganda vendida nas telas do sistema. Dado da plataforma: sem empresa_id.
model BannerPublicitario {
  id           String    @id @default(uuid()) @db.Uuid
  anunciante   String
  contato      String    @default("")
  texto        String    @default("")
  imagem       String?
  link         String?
  valorMensal  Decimal   @default(0) @map("valor_mensal") @db.Decimal(10, 2)
  inicio       DateTime  @db.Date
  fim          DateTime? @db.Date
  ativo        Boolean   @default(true)
  exibicoes    Int       @default(0)
  cliques      Int       @default(0)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  @@map("banners_publicitarios")
}

/// Post para rede social. Guarda o conteúdo; a arte é montada na tela (`montarPost`).
model PostSocial {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  titulo       String
  modelo       String
  formato      String
  conteudo     Json
  legenda      String   @default("")
  ajustes      Json     @default("{}")
  design       Json     @default("{}")
  /// Nome de quem criou, como estava na hora.
  autor        String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, atualizadoEm])
  @@map("posts_sociais")
}

/// Galeria de imagens próprias da empresa para os posts.
model ImagemPost {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  nome      String
  mime      String
  conteudo  Bytes
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  marcas  MarcaPost[]

  @@index([empresaId, criadoEm])
  @@map("imagens_post")
}

/// Identidade da empresa nos posts e chave dela no sistema de catálogo.
model MarcaPost {
  empresaId            String   @id @map("empresa_id") @db.Uuid
  nome                 String
  corPrincipal         String   @map("cor_principal")
  corDestaque          String   @map("cor_destaque")
  logoId               String?  @map("logo_id") @db.Uuid
  chaveCatalogoCifrada String?  @map("chave_catalogo_cifrada")
  /// Aparência e relacionamentos de que todo post novo parte.
  templatePadrao       Json?    @map("template_padrao")
  atualizadoEm         DateTime @updatedAt @map("atualizado_em")

  empresa Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  logo    ImagemPost? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  @@map("marcas_post")
}

/// Erro inesperado (500) da API, para a tela Saúde. Nunca guarda corpo nem query da requisição.
model ErroSistema {
  id        String   @id @default(uuid()) @db.Uuid
  metodo    String
  rota      String
  mensagem  String
  pilha     String?
  empresaId String?  @map("empresa_id") @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@map("erros_sistema")
}

/// Pedido de "esqueci minha senha": só o hash do token fica guardado.
model RedefinicaoSenha {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm])
  @@map("redefinicoes_senha")
}

model Perfil {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  nome         String
  descricao    String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa    Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  permissoes PerfilPermissao[]
  usuarios   Usuario[]

  @@unique([empresaId, nome])
  @@map("perfis")
}

/// Catálogo sincronizado a partir de packages/shared/src/permissoes.ts.
model Permissao {
  codigo    String @id
  grupo     String
  descricao String

  perfis PerfilPermissao[]

  @@map("permissoes")
}

model PerfilPermissao {
  perfilId        String @map("perfil_id") @db.Uuid
  permissaoCodigo String @map("permissao_codigo")

  perfil    Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoCodigo], references: [codigo], onDelete: Cascade)

  @@id([perfilId, permissaoCodigo])
  @@map("perfis_permissoes")
}

/// Banco com SQL ou fonte de planilhas: PASTA (agente; banco = caminho) e GOOGLE_DRIVE (API;
/// banco = id da pasta, usuario = e-mail da conta de serviço, senha_cifrada = chave JSON).
enum TipoConexao {
  POSTGRES
  MYSQL
  SQLSERVER
  PASTA
  GOOGLE_DRIVE
}

enum TipoBanco {
  POSTGRES
  MYSQL
  SQLSERVER
}

/// Agente local instalado na rede do cliente. Conecta por WebSocket de saída.
model Agente {
  id                     String    @id @default(uuid()) @db.Uuid
  empresaId              String    @map("empresa_id") @db.Uuid
  nome                   String
  /// SHA-256 (hex) do token do agente. O token em si só existe no agente.
  tokenHash              String?   @unique @map("token_hash")
  /// SHA-256 (hex) do código de ativação de uso único.
  codigoAtivacaoHash     String?   @map("codigo_ativacao_hash")
  codigoAtivacaoExpiraEm DateTime? @map("codigo_ativacao_expira_em")
  ativo                  Boolean   @default(true)
  versao                 String?
  hostname               String?
  sistemaOperacional     String?   @map("sistema_operacional")
  ultimoContatoEm        DateTime? @map("ultimo_contato_em")
  ativadoEm              DateTime? @map("ativado_em")
  criadoEm               DateTime  @default(now()) @map("criado_em")
  atualizadoEm           DateTime  @updatedAt @map("atualizado_em")

  empresa     Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  conexoes    ConexaoBanco[]
  impressoras Impressora[]

  @@unique([empresaId, nome])
  @@index([empresaId, codigoAtivacaoHash])
  @@map("agentes")
}

/// Banco do ERP do cliente, acessado pelo agente da mesma rede.
model ConexaoBanco {
  id           String    @id @default(uuid()) @db.Uuid
  empresaId    String    @map("empresa_id") @db.Uuid
  /// Nulo no Google Drive: quem lê é a API.
  agenteId     String?   @map("agente_id") @db.Uuid
  nome         String
  tipo         TipoConexao
  host         String
  porta        Int
  banco        String
  usuario      String
  /// AES-256-GCM com CHAVE_CRIPTOGRAFIA (ver src/cripto). Nulo = sem senha.
  senhaCifrada String?   @map("senha_cifrada")
  /// OpcoesConexao de packages/shared (ssl, instancia, tempoLimiteSegundos).
  opcoes       Json      @default("{}")
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  empresa   Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  agente    Agente?       @relation(fields: [agenteId], references: [id], onDelete: Restrict)
  consultas ConsultaSql[]

  @@unique([empresaId, nome])
  @@index([agenteId])
  @@map("conexoes_banco")
}

enum FinalidadeConsulta {
  LISTA_DIARIA
  BUSCA_PRODUTO
  OUTRA
}

/// Consulta SQL da empresa com placeholders {...}, executada no banco do ERP via agente.
model ConsultaSql {
  id                  String             @id @default(uuid()) @db.Uuid
  empresaId           String             @map("empresa_id") @db.Uuid
  conexaoId           String             @map("conexao_id") @db.Uuid
  nome                String
  descricao           String?
  finalidade          FinalidadeConsulta @default(OUTRA)
  sql                 String
  /// Conexão de planilhas: caminho na pasta ou id no Drive, nome para exibir e aba (nula = a primeira).
  arquivo             String?
  arquivoNome         String?            @map("arquivo_nome")
  aba                 String?
  /// CampoDinamico[] de packages/shared: colunas lidas na última execução bem-sucedida.
  campos              Json               @default("[]")
  /// SHA-256 de conexaoId + sql quando os campos foram lidos; diferente do atual = desatualizados.
  camposHash          String?            @map("campos_hash")
  camposAtualizadosEm DateTime?          @map("campos_atualizados_em")
  /// Nomes das colunas nas telas, definidos pelo super-admin. Só valem com o mesmo hash de campos: mudou a consulta, voltam os originais.
  rotulosColunas      Json               @default("{}") @map("rotulos_colunas")
  rotulosHash         String?            @map("rotulos_hash")
  /// Consulta do template do ERP de onde esta foi copiada.
  templateConsultaId  String?            @map("template_consulta_id") @db.Uuid
  /// SHA-256 do SQL do template no momento da cópia: compara com a consulta (ajustada?)
  /// e com o template atual (template mudou?).
  templateSqlHash     String?            @map("template_sql_hash")
  ativo               Boolean            @default(true)
  criadoEm            DateTime           @default(now()) @map("criado_em")
  atualizadoEm        DateTime           @updatedAt @map("atualizado_em")

  empresa  Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  conexao  ConexaoBanco      @relation(fields: [conexaoId], references: [id], onDelete: Restrict)
  template TemplateConsulta? @relation(fields: [templateConsultaId], references: [id], onDelete: SetNull)
  modelos  ModeloEtiqueta[]
  conteudosTela ConteudoTela[]

  @@unique([empresaId, nome])
  @@index([conexaoId])
  @@index([templateConsultaId])
  @@map("consultas_sql")
}

/// ERP cadastrado na plataforma (ex.: "ERP X – SQL Server"). Mantido pelo super-admin.
model SistemaErp {
  id           String    @id @default(uuid()) @db.Uuid
  nome         String    @unique
  fabricante   String?
  tipoBanco    TipoBanco @map("tipo_banco")
  descricao    String?
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  consultas TemplateConsulta[]
  empresas  Empresa[]

  @@map("sistemas_erp")
}

/// Consulta padrão do template de um ERP (TemplateERP da SPEC). Copiada para a empresa ao vincular.
model TemplateConsulta {
  id              String             @id @default(uuid()) @db.Uuid
  sistemaErpId    String             @map("sistema_erp_id") @db.Uuid
  nome            String
  descricao       String?
  finalidade      FinalidadeConsulta @default(OUTRA)
  sql             String
  /// Mapeamento de campos: [{ campo, origem?, descricao? }] — colunas que a consulta deve devolver
  /// e de onde vêm no ERP.
  camposEsperados Json               @default("[]") @map("campos_esperados")
  ordem           Int                @default(0)
  criadoEm        DateTime           @default(now()) @map("criado_em")
  atualizadoEm    DateTime           @updatedAt @map("atualizado_em")

  sistemaErp SistemaErp    @relation(fields: [sistemaErpId], references: [id], onDelete: Cascade)
  copias     ConsultaSql[]

  @@unique([sistemaErpId, nome])
  @@map("templates_consulta")
}

/// Modelo de etiqueta. Os elementos (CampoEtiqueta da SPEC) ficam em `layout`:
/// LayoutEtiqueta de packages/shared, validado por validarLayout ao gravar.
model ModeloEtiqueta {
  id            String   @id @default(uuid()) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  /// Consulta que fornece os campos dinâmicos.
  consultaId    String?  @map("consulta_id") @db.Uuid
  /// Impressora da lista do dia e sugerida na etiqueta avulsa.
  impressoraId  String?  @map("impressora_id") @db.Uuid
  naListaDiaria Boolean  @default(false) @map("na_lista_diaria")
  nome          String
  descricao     String?
  layout        Json
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  empresa      Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  consulta     ConsultaSql?        @relation(fields: [consultaId], references: [id], onDelete: SetNull)
  agendamentos AgendamentoModelo[]
  impressora   Impressora?         @relation(fields: [impressoraId], references: [id], onDelete: SetNull)
  itens        ItemLista[]

  @@unique([empresaId, nome])
  @@index([consultaId])
  @@map("modelos_etiqueta")
}

/// Lista do dia de uma empresa: produtos lidos das consultas, agrupados por modelo/impressora.
model ListaDiaria {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  data         DateTime @db.Date
  /// ErroLista[] de packages/shared: modelos que não puderam ser lidos.
  erros        Json     @default("[]")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  itens   ItemLista[]

  @@unique([empresaId, data])
  @@map("listas_diarias")
}

enum StatusItemLista {
  PENDENTE
  NA_FILA
  IMPRESSO
  DESCARTADO
}

model ItemLista {
  id           String          @id @default(uuid()) @db.Uuid
  empresaId    String          @map("empresa_id") @db.Uuid
  listaId      String          @map("lista_id") @db.Uuid
  modeloId     String          @map("modelo_id") @db.Uuid
  impressoraId String?         @map("impressora_id") @db.Uuid
  /// Identificação do produto (código/EAN) para não repetir o que já foi impresso.
  chave        String
  descricao    String
  /// Linha da consulta usada para preencher a etiqueta.
  registro     Json
  quantidade   Int             @default(1)
  status       StatusItemLista @default(PENDENTE)
  trabalhoId   String?         @map("trabalho_id") @db.Uuid
  impressoEm   DateTime?       @map("impresso_em")
  criadoEm     DateTime        @default(now()) @map("criado_em")
  atualizadoEm DateTime        @updatedAt @map("atualizado_em")

  lista      ListaDiaria        @relation(fields: [listaId], references: [id], onDelete: Cascade)
  modelo     ModeloEtiqueta     @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  impressora Impressora?        @relation(fields: [impressoraId], references: [id], onDelete: SetNull)
  trabalho   TrabalhoImpressao? @relation(fields: [trabalhoId], references: [id], onDelete: SetNull)

  @@index([listaId, status])
  @@index([trabalhoId])
  @@map("itens_lista")
}

enum StatusTrabalho {
  PENDENTE
  ENVIANDO
  CONCLUIDO
  ERRO
  CANCELADO
}

enum OrigemTrabalho {
  LISTA
  AVULSA
  AGENDAMENTO
}

/// Trabalho de impressão: conteúdo já gerado na linguagem da impressora, entregue pelo agente.
/// Fila durável no próprio Postgres (ver src/impressao/despacho.service.ts).
model TrabalhoImpressao {
  id                  String              @id @default(uuid()) @db.Uuid
  empresaId           String              @map("empresa_id") @db.Uuid
  impressoraId        String?             @map("impressora_id") @db.Uuid
  /// Nomes guardados para o histórico sobreviver à exclusão do modelo/impressora.
  impressoraNome      String              @map("impressora_nome")
  modeloNome          String              @map("modelo_nome")
  linguagem           LinguagemImpressora
  origem              OrigemTrabalho
  quantidadeEtiquetas Int                 @map("quantidade_etiquetas")
  conteudo            Bytes
  /// Preenchido quando a faxina apagou os bytes: o histórico continua, o reenvio não.
  conteudoApagadoEm   DateTime?           @map("conteudo_apagado_em")
  /// Códigos dos produtos do trabalho, para reconferir o banimento ao reenviar (os bytes não dizem).
  codigosProdutos     String[]            @default([]) @map("codigos_produtos")
  status              StatusTrabalho      @default(PENDENTE)
  tentativas          Int                 @default(0)
  erro                String?
  criadoPorId         String?             @map("criado_por_id") @db.Uuid
  criadoEm            DateTime            @default(now()) @map("criado_em")
  enviadoEm           DateTime?           @map("enviado_em")
  concluidoEm         DateTime?           @map("concluido_em")
  atualizadoEm        DateTime            @updatedAt @map("atualizado_em")

  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  impressora Impressora? @relation(fields: [impressoraId], references: [id], onDelete: SetNull)
  criadoPor  Usuario?    @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  itens      ItemLista[]

  @@index([empresaId, criadoEm])
  @@index([status])
  @@map("trabalhos_impressao")
}

enum LinguagemImpressora {
  ZPL
  PPLA
  PPLB
  ESCPOS
  PDF
}

enum MetodoImpressora {
  /// Envio direto para IP:porta (RAW, normalmente 9100).
  REDE
  /// Impressora instalada no sistema do computador do agente.
  SISTEMA
}

model Impressora {
  id              String              @id @default(uuid()) @db.Uuid
  empresaId       String              @map("empresa_id") @db.Uuid
  /// Agente que entrega os trabalhos (Fase 5).
  agenteId        String?             @map("agente_id") @db.Uuid
  nome            String
  linguagem       LinguagemImpressora
  dpi             Int                 @default(203)
  metodo          MetodoImpressora    @default(REDE)
  endereco        String
  modelo          String?
  larguraMaximaMm Float?              @map("largura_maxima_mm")
  ativo           Boolean             @default(true)
  criadoEm        DateTime            @default(now()) @map("criado_em")
  atualizadoEm    DateTime            @updatedAt @map("atualizado_em")

  empresa      Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  agente       Agente?             @relation(fields: [agenteId], references: [id], onDelete: SetNull)
  modelos      ModeloEtiqueta[]
  itens        ItemLista[]
  trabalhos    TrabalhoImpressao[]
  agendamentos AgendamentoModelo[]

  @@unique([empresaId, nome])
  @@index([agenteId])
  @@map("impressoras")
}

/// Parâmetros de cobrança. Linha com empresa_id nulo = globais (única, criada na inicialização);
/// linha por empresa sobrescreve só os campos preenchidos (null = herda).
model ParametroCobranca {
  id                  String   @id @default(uuid()) @db.Uuid
  empresaId           String?  @unique @map("empresa_id") @db.Uuid
  diasAvisoPrevio     Int?     @map("dias_aviso_previo")
  diasCarencia        Int?     @map("dias_carencia")
  diasAteBloqueio     Int?     @map("dias_ate_bloqueio")
  frequenciaAvisoDias Int?     @map("frequencia_aviso_dias")
  /// Só nos globais: hora (0–23, FUSO_HORARIO) da avaliação diária.
  horaAvaliacao       Int?     @map("hora_avaliacao")
  mensagemAvisoPrevio String?  @map("mensagem_aviso_previo")
  mensagemCarencia    String?  @map("mensagem_carencia")
  mensagemPreBloqueio String?  @map("mensagem_pre_bloqueio")
  mensagemBloqueio    String?  @map("mensagem_bloqueio")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("parametros_cobranca")
}

/// Mensalidade fixa da empresa.
model Assinatura {
  id              String   @id @default(uuid()) @db.Uuid
  empresaId       String   @unique @map("empresa_id") @db.Uuid
  valorMensal     Decimal  @map("valor_mensal") @db.Decimal(10, 2)
  /// Dia do mês (1–31; em meses curtos vale o último dia).
  diaVencimento   Int      @map("dia_vencimento")
  /// Vencimento em aberto mais antigo. Pagar avança este campo.
  vencimentoAtual DateTime @map("vencimento_atual") @db.Date
  /// O job diário não altera o status desta empresa.
  controleManual  Boolean  @default(false) @map("controle_manual")
  observacoes     String?
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  empresa    Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pagamentos PagamentoAssinatura[]

  @@map("assinaturas")
}

model PagamentoAssinatura {
  id                String   @id @default(uuid()) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  assinaturaId      String   @map("assinatura_id") @db.Uuid
  valor             Decimal  @db.Decimal(10, 2)
  /// Mensalidades quitadas por este pagamento.
  meses             Int
  vencimentoQuitado DateTime @map("vencimento_quitado") @db.Date
  novoVencimento    DateTime @map("novo_vencimento") @db.Date
  pagoEm            DateTime @map("pago_em") @db.Date
  observacao        String?
  registradoPorId   String?  @map("registrado_por_id") @db.Uuid
  criadoEm          DateTime @default(now()) @map("criado_em")

  empresa       Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  assinatura    Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  registradoPor Usuario?   @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([empresaId, criadoEm])
  @@map("pagamentos_assinatura")
}

enum TipoAvisoCobranca {
  AVISO_PREVIO
  CARENCIA
  PRE_BLOQUEIO
  BLOQUEADA
}

/// Aviso emitido pelo job (repetido a cada frequenciaAvisoDias) e exibido aos usuários da empresa.
model AvisoCobranca {
  id         String            @id @default(uuid()) @db.Uuid
  empresaId  String            @map("empresa_id") @db.Uuid
  tipo       TipoAvisoCobranca
  mensagem   String
  /// Vencimento a que o aviso se refere: pagar torna os avisos anteriores obsoletos.
  vencimento DateTime          @db.Date
  criadoEm   DateTime          @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, criadoEm])
  @@map("avisos_cobranca")
}

enum OrigemExecucao {
  AGENDADA
  MANUAL
}

/// Execuções da avaliação diária de inadimplência (no máximo uma agendada por dia).
model ExecucaoAvaliacao {
  id          String         @id @default(uuid()) @db.Uuid
  /// Dia (fuso da plataforma) da execução.
  data        DateTime       @db.Date
  origem      OrigemExecucao
  iniciadoEm  DateTime       @default(now()) @map("iniciado_em")
  concluidoEm DateTime?      @map("concluido_em")
  resultado   Json?
  erro        String?

  @@index([data])
  @@map("execucoes_avaliacao")
}

model LogAuditoria {
  id         String   @id @default(uuid()) @db.Uuid
  empresaId  String?  @map("empresa_id") @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  /// Ex.: usuario.criar, perfil.editar, empresa.criar
  acao       String
  entidade   String
  entidadeId String?  @map("entidade_id")
  detalhes   Json?
  criadoEm   DateTime @default(now()) @map("criado_em")

  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([empresaId, criadoEm])
  @@map("logs_auditoria")
}

/// Agendamento de um modelo: a cada ciclo executa a consulta do modelo e põe na lista do dia
/// o que ainda não foi impresso/descartado hoje; com impressão automática, já imprime.
model AgendamentoModelo {
  id                 String    @id @default(uuid()) @db.Uuid
  empresaId          String    @map("empresa_id") @db.Uuid
  modeloId           String    @map("modelo_id") @db.Uuid
  /// Nulo = impressora padrão do modelo.
  impressoraId       String?   @map("impressora_id") @db.Uuid
  /// Usuário com quem roda (placeholders {usuario.*} e autoria): quem cadastrou ou editou por último.
  responsavelId      String?   @map("responsavel_id") @db.Uuid
  intervaloSegundos  Int       @map("intervalo_segundos")
  /// Referência do ciclo: as execuções caem em inicioEm + n × intervalo.
  inicioEm           DateTime  @map("inicio_em")
  imprimirAutomatico Boolean   @default(false) @map("imprimir_automatico")
  ativo              Boolean   @default(true)
  proximaExecucaoEm  DateTime? @map("proxima_execucao_em")
  ultimaExecucaoEm   DateTime? @map("ultima_execucao_em")
  /// Últimas execuções (mais recente primeiro).
  historico          Json      @default("[]")
  criadoEm           DateTime  @default(now()) @map("criado_em")
  atualizadoEm       DateTime  @updatedAt @map("atualizado_em")

  empresa     Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  modelo      ModeloEtiqueta @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  impressora  Impressora?    @relation(fields: [impressoraId], references: [id], onDelete: SetNull)
  responsavel Usuario?       @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@index([ativo, proximaExecucaoEm])
  @@map("agendamentos")
}

/// Código de barras que não sai em etiqueta. Chave: empresa + código normalizado (normalizarCodigoBarras).
model ProdutoBanido {
  empresaId    String   @map("empresa_id") @db.Uuid
  codigoBarras String   @map("codigo_barras")
  motivo       String?
  /// Nome de quem baniu, como estava na hora.
  criadoPor    String?  @map("criado_por")
  criadoEm     DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([empresaId, codigoBarras])
  @@map("produtos_banidos")
}

/// Uma execução de consulta salva, para medir tempo e falhas. Apagada depois de 35 dias.
model ExecucaoConsulta {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  /// Sem chave estrangeira: o histórico sobrevive à exclusão da consulta, com o nome da época.
  consultaId   String   @map("consulta_id") @db.Uuid
  consultaNome String   @map("consulta_nome")
  duracaoMs    Int      @map("duracao_ms")
  linhas       Int      @default(0)
  ok           Boolean
  erro         String?
  criadoEm     DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, criadoEm])
  @@index([criadoEm])
  @@map("execucoes_consulta")
}

/// O que notificar e como. Evento: EVENTOS_NOTIFICACAO de packages/shared. Sem registro = desligada.
model RegraNotificacao {
  empresaId      String   @map("empresa_id") @db.Uuid
  evento         String
  ativo          Boolean  @default(false)
  limite         Int      @default(0)
  canalAgente    Boolean  @default(true) @map("canal_agente")
  canalSistema   Boolean  @default(true) @map("canal_sistema")
  canalEmail     Boolean  @default(false) @map("canal_email")
  canalCelular   Boolean  @default(false) @map("canal_celular")
  repetirMinutos Int      @default(0) @map("repetir_minutos")
  /// Ids dos agentes que recebem o balão; vazio = todos.
  agenteIds      Json     @default("[]") @map("agente_ids")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([empresaId, evento])
  @@index([ativo])
  @@map("regras_notificacao")
}

/// Quando a empresa aceita receber avisos, no fuso FUSO_HORARIO. Sem registro = JANELA_PADRAO.
model JanelaNotificacao {
  empresaId  String @id @map("empresa_id") @db.Uuid
  horaInicio String @map("hora_inicio")
  horaFim    String @map("hora_fim")
  /// 0 = domingo.
  diasSemana Json   @map("dias_semana")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("janelas_notificacao")
}

/// Problema avisado. Fica aberto (resolvidaEm nulo) enquanto a condição continuar; (evento, chave) identifica o problema.
model Notificacao {
  id              String    @id @default(uuid()) @db.Uuid
  empresaId       String    @map("empresa_id") @db.Uuid
  evento          String
  chave           String
  titulo          String
  mensagem        String
  nivel           String
  canalAgente     Boolean   @map("canal_agente")
  canalSistema    Boolean   @map("canal_sistema")
  canalEmail      Boolean   @default(false) @map("canal_email")
  canalCelular    Boolean   @default(false) @map("canal_celular")
  /// Agentes que devem receber (vazio = todos) e os que confirmaram o último envio.
  agenteIds       Json      @default("[]") @map("agente_ids")
  entregueAgentes Json      @default("[]") @map("entregue_agentes")
  vezes           Int       @default(1)
  ultimoEnvioEm   DateTime  @default(now()) @map("ultimo_envio_em")
  lidaEm          DateTime? @map("lida_em")
  resolvidaEm     DateTime? @map("resolvida_em")
  criadoEm        DateTime  @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, criadoEm])
  @@index([empresaId, resolvidaEm])
  @@map("notificacoes")
}

/// Parâmetros do módulo de telas: empresa nula = padrão da plataforma, com empresa = sobrescrita.
model ParametroTelas {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String?  @unique @map("empresa_id") @db.Uuid
  valores      Json     @default("{}")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("parametros_telas")
}

/// Resolução e tipo de equipamento, definidos por empresa.
model PerfilTela {
  id            String   @id @default(uuid()) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  nome          String
  tipo          String
  largura       Int
  altura        Int
  margemPct     Int      @default(0) @map("margem_pct")
  nivelAnimacao String   @default("AUTOMATICO") @map("nivel_animacao")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  telas   Tela[]

  @@unique([empresaId, nome])
  @@map("perfis_tela")
}

/// O equipamento: TV, painel, projetor ou tablet. Sem token, espera um equipamento novo.
model Tela {
  id               String    @id @default(uuid()) @db.Uuid
  empresaId        String    @map("empresa_id") @db.Uuid
  perfilId         String    @map("perfil_id") @db.Uuid
  nome             String
  local            String?
  /// SHA-256 do token tv_...
  tokenHash        String?   @unique @map("token_hash")
  ultimoContatoEm  DateTime? @map("ultimo_contato_em")
  larguraDetectada Int?      @map("largura_detectada")
  alturaDetectada  Int?      @map("altura_detectada")
  escalaDetectada  Float?    @map("escala_detectada")
  navegador        String?
  versaoPlayer     String?   @map("versao_player")
  emSegundoPlano   Boolean   @default(false) @map("em_segundo_plano")
  /// HH:MM no fuso do sistema; fora dele, ficar sem aviso não é problema.
  horarioInicio    String?   @map("horario_inicio")
  horarioFim       String?   @map("horario_fim")
  /// Vai no próximo aviso da tela.
  comando          String?
  criadoEm         DateTime  @default(now()) @map("criado_em")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em")

  empresa Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  perfil  PerfilTela   @relation(fields: [perfilId], references: [id], onDelete: Restrict)
  quedas  QuedaTela[]
  pedidos PedidoVinculoTela[]
  conteudos TelaConteudo[]

  @@index([empresaId])
  @@map("telas")
}

/// Pedido de uma TV sem vínculo: o código está no QR e o segredo só com ela.
model PedidoVinculoTela {
  id          String    @id @default(uuid()) @db.Uuid
  codigoHash  String    @unique @map("codigo_hash")
  segredoHash String    @unique @map("segredo_hash")
  largura     Int
  altura      Int
  escala      Float?
  navegador   String?
  expiraEm    DateTime  @map("expira_em")
  telaId      String?   @map("tela_id") @db.Uuid
  entregueEm  DateTime? @map("entregue_em")
  criadoEm    DateTime  @default(now()) @map("criado_em")

  tela Tela? @relation(fields: [telaId], references: [id], onDelete: Cascade)

  @@index([expiraEm])
  @@map("pedidos_vinculo_tela")
}

/// Intervalo em que a tela ficou sem aviso, gravado quando ela volta.
model QuedaTela {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  telaId    String   @map("tela_id") @db.Uuid
  inicio    DateTime
  fim       DateTime

  tela Tela @relation(fields: [telaId], references: [id], onDelete: Cascade)

  @@index([telaId, inicio])
  @@index([fim])
  @@map("quedas_tela")
}

/// O que passa nas telas: uma consulta, um modelo animado e a cópia dos dados que a TV lê.
model ConteudoTela {
  id                   String    @id @default(uuid()) @db.Uuid
  empresaId            String    @map("empresa_id") @db.Uuid
  /// Consulta excluída: os dados vencem e o conteúdo sai do ar sozinho.
  consultaId           String?   @map("consulta_id") @db.Uuid
  nome                 String
  modelo               String
  /// ConfigConteudoTela de packages/shared.
  config               Json
  intervaloMinutos     Int       @map("intervalo_minutos")
  validadeMinutos      Int       @map("validade_minutos")
  publicado            Boolean   @default(false)
  /// HH:MM no fuso do sistema.
  horarioInicio        String?   @map("horario_inicio")
  horarioFim           String?   @map("horario_fim")
  /// AAAA-MM-DD no fuso do sistema.
  dataInicio           String?   @map("data_inicio")
  dataFim              String?   @map("data_fim")
  /// ItemConteudoTela[]: a cópia dos dados.
  itens                Json      @default("[]")
  quantidadeItens      Int       @default(0) @map("quantidade_itens")
  dadosEm              DateTime? @map("dados_em")
  erro                 String?
  proximaAtualizacaoEm DateTime? @map("proxima_atualizacao_em")
  /// Último a salvar: a consulta pode usar {usuario.*}.
  responsavelId        String?   @map("responsavel_id") @db.Uuid
  criadoEm             DateTime  @default(now()) @map("criado_em")
  atualizadoEm         DateTime  @updatedAt @map("atualizado_em")

  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  consulta    ConsultaSql? @relation(fields: [consultaId], references: [id], onDelete: SetNull)
  responsavel Usuario?     @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  telas       TelaConteudo[]

  @@unique([empresaId, nome])
  @@index([publicado, proximaAtualizacaoEm])
  @@map("conteudos_tela")
}

model TelaConteudo {
  telaId     String @map("tela_id") @db.Uuid
  conteudoId String @map("conteudo_id") @db.Uuid
  empresaId  String @map("empresa_id") @db.Uuid

  tela     Tela         @relation(fields: [telaId], references: [id], onDelete: Cascade)
  conteudo ConteudoTela @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  @@id([telaId, conteudoId])
  @@index([conteudoId])
  @@map("telas_conteudo")
}

/// Imagem enviada pela empresa para as telas. Os bytes não mudam: excluir e enviar de novo gera outro id.
model ImagemTela {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  nome      String
  mime      String
  largura   Int?
  altura    Int?
  bytes     Int
  conteudo  Bytes
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, criadoEm])
  @@map("imagens_tela")
}

# Copie para apps/api/.env e ajuste.
DATABASE_URL=postgresql://etiquetas:etiquetas@localhost:5432/etiquetas?schema=public

# Segredo do JWT: mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRACAO=12h

PORTA=3000

# Origem do frontend quando servido em outro domínio (opcional; em dev o Vite faz proxy de /api).
CORS_ORIGEM=

# Super-admin criado na inicialização se ainda não existir nenhum usuário com este e-mail.
SUPERADMIN_EMAIL=admin@exemplo.com
SUPERADMIN_SENHA=troque-esta-senha
SUPERADMIN_NOME=Administrador da Plataforma

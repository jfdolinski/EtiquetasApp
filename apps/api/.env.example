# Copie para apps/api/.env e ajuste.
DATABASE_URL=postgresql://etiquetas:etiquetas@localhost:5432/etiquetas?schema=public

# Segredo do JWT: mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRACAO=12h

# Chave AES-256 das senhas dos bancos dos clientes: 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde com cuidado: perdê-la obriga a redigitar todas as senhas das conexões.
CHAVE_CRIPTOGRAFIA=

PORTA=3000

# Proxies reversos à frente da API. Easypanel: 2 (Traefik + nginx do web). Em desenvolvimento
# com o proxy do Vite: 1. Sem proxy: 0.
PROXIES_CONFIAVEIS=1

# Fuso de {data_hoje} e {data_hora_agora} nas consultas SQL.
FUSO_HORARIO=America/Sao_Paulo

# Origem do frontend quando servido em outro domínio (opcional; em dev o Vite faz proxy de /api).
CORS_ORIGEM=

# Super-admin criado na inicialização se ainda não existir nenhum usuário com este e-mail.
SUPERADMIN_EMAIL=admin@exemplo.com
SUPERADMIN_SENHA=troque-esta-senha
SUPERADMIN_NOME=Administrador da Plataforma

# E-mail (opcional). Sem SMTP_HOST nada é enviado e o "Esqueci minha senha" não aparece.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
# Endereço público do site, usado nos links dos e-mails. Ex.: https://etiquetas.seudominio.com.br
URL_PUBLICA=

# Sistema de catálogo, fonte das imagens dos posts (opcional). Sem ele, só imagem própria.
CATALOGO_URL=

# Avisos no celular com o app fechado: JSON da conta de serviço do Firebase, em base64 (opcional).
FCM_CONTA_SERVICO=

# Faxina diária. Dias até apagar os bytes de trabalhos de impressão terminados (o histórico fica)
# e até apagar registros de auditoria.
RETENCAO_CONTEUDO_DIAS=90
RETENCAO_AUDITORIA_DIAS=730

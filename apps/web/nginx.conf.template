map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# O Traefik do Easypanel termina o HTTPS e informa o protocolo original.
map $http_x_forwarded_proto $proto_original {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

# Robôs que montam a prévia de um link (WhatsApp, Facebook, Telegram...). Eles não rodam JavaScript:
# para eles, /loja/... vira uma página da API com o nome e a logomarca da empresa dona do link.
map $http_user_agent $robo_de_previa {
  default 0;
  "~*(whatsapp|facebookexternalhit|facebot|telegrambot|twitterbot|slackbot|linkedinbot|discordbot|skypeuripreview|pinterest|vkshare|embedly|redditbot|applebot|googlebot|bingbot)" 1;
}

server {
  listen 80;
  root /usr/share/nginx/html;
  server_tokens off;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  # Com o token no navegador, é a CSP que impede script injetado de rodar. Inline só em estilos (Konva e Tailwind).
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; object-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  # API e WebSocket dos agentes no mesmo domínio: sem CORS.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Acrescenta o IP do Traefik: a API confia em 2 proxies (PROXIES_CONFIAVEIS=2).
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $proto_original;
    # Layouts com imagens coloridas e lotes de etiquetas (a API aceita até 20 MB).
    client_max_body_size 21m;
    # Consultas no banco do cliente podem levar até 10 min; o WebSocket tem ping a cada 30 s.
    proxy_read_timeout 700s;
    proxy_send_timeout 700s;
  }

  # Executáveis do agente local, gerados no build da imagem.
  location /downloads/ {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
    add_header Content-Disposition "attachment";
  }

  # add_header num location substitui os do server: os de segurança são repetidos.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    add_header X-Content-Type-Options nosniff always;
  }

  # index.html nunca em cache: um deploy novo aparece no próximo carregamento.
  location = /index.html {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; object-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  }

  # SPA: qualquer outra rota cai no index.html.
  location ^~ /loja/ {
    error_page 418 = @previa_da_loja;
    if ($robo_de_previa) {
      return 418;
    }
    try_files $uri /index.html;
  }

  location @previa_da_loja {
    rewrite ^/loja/(.+?)/?$ /api/loja/$1/previa break;
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $proto_original;
  }

  location / {
    try_files $uri /index.html;
  }
}
